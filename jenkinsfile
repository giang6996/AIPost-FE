pipeline {
    agent any

    parameters {
        choice (
            name: 'DEPLOY_TARGET',
            choices: ['netlify', 's3'],
            description: 'Frontend deployment destination'
        )
    }

    environment {

        AWS_REGION = "ap-southeast-1"

        ENVIRONMENT_BOOTSTRAP_PARAMETER = "/aipost-bootstrap/active"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Load Deployment Config') {
            steps {
                script {
                    env.DEPLOY_TARGET = params.DEPLOY_TARGET

                    env.SSM_PARAMETER_PREFIX = sh(
                        script: """
                            aws ssm get-parameter \
                            --name "${ENVIRONMENT_BOOTSTRAP_PARAMETER}" \
                            --region "${AWS_REGION}" \
                            --query 'Parameter.Value' \
                            --output text
                        """,
                        returnStdout: true
                    ).trim()

                    env.FRONTEND_S3_BUCKET = sh(
                        script: """
                            aws ssm get-parameter \
                            --name "${env.SSM_PARAMETER_PREFIX}/frontend/S3_FRONTEND_BUCKET" \
                            --region "${AWS_REGION}" \
                            --query 'Parameter.Value' \
                            --output text
                        """,
                        returnStdout: true
                    ).trim()

                    env.FRONTEND_APP_URL = sh(
                        script: """
                            aws ssm get-parameter \
                            --name "${env.SSM_PARAMETER_PREFIX}/frontend/APP_URL" \
                            --region "${AWS_REGION}" \
                            --query 'Parameter.Value' \
                            --output text
                        """,
                        returnStdout: true
                    ).trim()

                    env.VITE_TINYMCE_API_KEY = sh(
                        script: """
                            aws ssm get-parameter \
                            --name "${env.SSM_PARAMETER_PREFIX}/frontend/TINYMCE_API_KEY" \
                            --with-decryption \
                            --region "${AWS_REGION}" \
                            --query 'Parameter.Value' \
                            --output text
                        """,
                        returnStdout: true
                    ).trim()

                    // Fix API url missing protocol
                    def apiDomain = sh(
                        script: """
                            aws ssm get-parameter \
                            --name "${env.SSM_PARAMETER_PREFIX}/backend/API_URL" \
                            --region "${AWS_REGION}" \
                            --query 'Parameter.Value' \
                            --output text
                        """,
                        returnStdout: true
                    ).trim()

                    env.VITE_API_BASE_URL = "https://${apiDomain}"
                }
            }
        }

        stage('Load Netlify Config') {

            when {
                expression {
                    params.DEPLOY_TARGET == 'netlify'
                }
            }

            steps {
                script {
                    env.NETLIFY_SITE_ID = sh(
                        script: """
                            aws ssm get-parameter \
                            --name "${env.SSM_PARAMETER_PREFIX}/jenkins/NETLIFY_SITE_ID" \
                            --with-decryption \
                            --region "${AWS_REGION}" \
                            --query 'Parameter.Value' \
                            --output text
                        """,
                        returnStdout: true
                    ).trim()

                    env.NETLIFY_AUTH_TOKEN = sh(
                        script: """
                            aws ssm get-parameter \
                            --name "${env.SSM_PARAMETER_PREFIX}/jenkins/NETLIFY_AUTH_TOKEN" \
                            --with-decryption \
                            --region "${AWS_REGION}" \
                            --query 'Parameter.Value' \
                            --output text
                        """,
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Build Frontend') {
            steps {
 
                sh '''
                    npm run build
                '''
            }
        }
        

        stage('Verify Build') {
            steps {
                sh '''
                    test -d dist
                    test -f dist/_redirects
                    test -f dist/index.html

                    echo "Frontend build verified."
                '''
            }
        }

        stage('Deploy to S3') {

            when {
                expression {
                    env.DEPLOY_TARGET == 's3'
                }
            }
            steps {
                sh '''
                    aws s3 sync \
                      dist/ \
                      s3://${FRONTEND_S3_BUCKET} \
                      --delete \
                      --region ${AWS_REGION}
                '''
            }
        }

        stage('Deploy to Netlify') {
            when {
                expression {
                    env.DEPLOY_TARGET == 'netlify'
                }
            }

            steps {
                sh '''
                    set -e

                    netlify deploy \
                    --dir=dist \
                    --prod
                '''
            }
        }

        stage('Frontend Test') {
            steps {
                sh '''
                    set -e

                    echo "Checking AIPost frontend..."

                    curl --fail \
                    --show-error \
                    --silent \
                    --retry 6 \
                    --retry-delay 5 \
                    "https://${FRONTEND_APP_URL}/" \
                    > /dev/null

                    echo "Frontend is reachable."
                '''
            }
        }

        stage('Verify S3 Deployment') {
            when {
                expression {
                    params.DEPLOY_TARGET == 's3'
                }
            }

            steps {
                sh '''
                    set -e

                    echo "Checking frontend artifact in S3..."

                    aws s3api head-object \
                    --bucket "${FRONTEND_S3_BUCKET}" \
                    --key "index.html" \
                    --region "${AWS_REGION}" \
                    > /dev/null

                    echo "S3 frontend artifact verified."
                '''
            }
        }
    }

    post {
        success {
            echo 'AIPost frontend CI/CD succeeded.'
        }

        failure {
            echo 'AIPost frontend CI/CD failed.'
        }
    }
}