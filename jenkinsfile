pipeline {
    agent any

    environment {
        VITE_API_BASE_URL = 'https://api.jeblearning.pro.vn'

        AWS_REGION = 'ap-southeast-1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Load Deployment Config') {
            steps {
                script {
                    env.FRONTEND_S3_BUCKET = sh(
                        script: '''
                            aws ssm get-parameter \
                            --name "/aipost/ec2/frontend/S3_FRONTEND_BUCKET" \
                            --region "${AWS_REGION}" \
                            --query 'Parameter.Value' \
                            --output text
                        ''',
                        returnStdout: true
                    ).trim()

                    env.VITE_TINYMCE_API_KEY = sh(
                        script: '''
                            aws ssm get-parameter \
                            --name "/aipost/ec2/frontend/TINYMCE_API_KEY" \
                            --with-decryption \
                            --region "${AWS_REGION}" \
                            --query 'Parameter.Value' \
                            --output text
                        ''',
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Build Frontend') {
            steps {
 
                sh '''
                    npm run build
                '''
            }
        }
        

        stage('Verify Build') {
            steps {
                sh '''
                    test -d dist
                    test -f dist/index.html

                    echo "Frontend build verified."
                '''
            }
        }

        stage('Deploy to S3') {
            steps {
                sh '''
                    aws s3 sync \
                      dist/ \
                      s3://${FRONTEND_S3_BUCKET} \
                      --delete \
                      --region ${AWS_REGION}
                '''
            }
        }
    }

    post {
        success {
            echo 'AIPost frontend CI/CD succeeded.'
        }

        failure {
            echo 'AIPost frontend CI/CD failed.'
        }
    }
}